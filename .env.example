# Copy to .env.local. Status and choices are on the right of each variable.
# Commented assignments are inactive examples.
# Omit OPTIONAL variables to use defaults. Empty is not the same as unset.

# Application
# Dev hosts: localhost:*,127.0.0.1:*,*.ngrok-free.app,*.ngrok-free.dev,*.ngrok.app,*.trycloudflare.com
# NODE_ENV=development                                           # AUTO by Next.js. Default outside Next.js: development. Choices: development, test, production.
APP_URL=http://localhost:3000                                    # REQUIRED for production. Default: http://localhost:3000.
APP_ALLOWED_HOSTS=                                               # OPTIONAL CSV/wildcards. Default: dev hosts above, APP_URL only in production.

# Database
DATABASE_URL=postgres://catetin:catetin@localhost:54330/catetin # REQUIRED PostgreSQL connection.
# DATABASE_URL_DIRECT=postgres://catetin:catetin@localhost:54330/catetin # OPTIONAL Studio connection. Default: DATABASE_URL.

# Authentication
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters # REQUIRED in production. Random, at least 32 characters.
GOOGLE_CLIENT_ID=                                                # IF Google login. Set both Google values.
GOOGLE_CLIENT_SECRET=                                            # IF Google login.

# Email
SMTP_HOST=localhost                                              # IF email login or delivery. Default: localhost.
SMTP_PORT=1026                                                   # OPTIONAL port. Default: 1026.
SMTP_SECURE=false                                                # OPTIONAL true, false. Default: false. true uses TLS from the start.
SMTP_USER=                                                       # IF SMTP authentication. Set both credentials.
SMTP_PASS=                                                       # IF SMTP authentication.
SMTP_FROM_NAME=Catetin                                           # OPTIONAL sender name. Default: Catetin.
SMTP_FROM_EMAIL=no-reply@catetin.local                           # OPTIONAL sender email. Default: no-reply@catetin.local.

# Cron and signing
CRON_SECRET=replace-with-a-random-cron-secret                    # REQUIRED in production. Cron Bearer token.
SIGNING_SECRET=replace-with-a-random-signing-secret              # REQUIRED in production. Signs links and approvals.

# Exchange rates
FX_PROVIDER=exchangerate-api                                     # OPTIONAL exchangerate-api, frankfurter. Default: exchangerate-api.
FX_FALLBACK_PROVIDER=frankfurter                                 # OPTIONAL exchangerate-api, frankfurter, none. Default: frankfurter.

# AI assistant, scan and voice
GEMINI_API_KEY=                                                  # IF AI features. Empty disables AI.
# GEMINI_MODEL=gemini-3.5-flash-lite                             # OPTIONAL Google model ID. Default: gemini-3.5-flash-lite.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash                         # OPTIONAL model ID or none. Default: gemini-3.5-flash.
# ASSISTANT_USER_MESSAGES_PER_DAY=15                             # OPTIONAL positive integer. Default: 15 messages per user daily.
# ASSISTANT_USER_CALLS_PER_DAY=60                                # OPTIONAL positive integer. Default: 60 model calls per user daily.
# ASSISTANT_APP_CALLS_PER_DAY=450                                # OPTIONAL positive integer. Default: 450 model calls for the app daily.

# Web push
VAPID_PUBLIC_KEY=                                                # IF push notifications. Set both VAPID keys.
VAPID_PRIVATE_KEY=                                               # IF push notifications.
VAPID_SUBJECT=mailto:admin@example.com                           # OPTIONAL contact mailto or HTTPS URL. Default: mailto:admin@example.com.

# Storage
STORAGE_DRIVER=local                                             # OPTIONAL local, supabase. Default: local. Supabase needs URL and server key.
# STORAGE_LOCAL_DIR=.data/files                                  # OPTIONAL persistent local directory. Default: .data/files.
# SUPABASE_STORAGE_BUCKET=files                                  # OPTIONAL existing Supabase bucket. Default: files.

# Live updates
REALTIME_DRIVER=pg                                               # OPTIONAL pg, supabase, none. Default: pg. Supabase needs all key groups below.

# Supabase
SUPABASE_URL=                                                    # IF Supabase storage or realtime. Project HTTPS URL.
SUPABASE_SECRET_KEY=                                             # IF Supabase. Server key, preferred over SERVICE_ROLE_KEY.
SUPABASE_SERVICE_ROLE_KEY=                                       # ALTERNATIVE legacy server key.
SUPABASE_PUBLISHABLE_KEY=                                        # IF Supabase realtime. Public key, preferred over ANON_KEY.
SUPABASE_ANON_KEY=                                               # ALTERNATIVE legacy public key.
SUPABASE_JWT_PRIVATE_KEY=                                        # IF Supabase realtime. Private P-256 JWK JSON with kid.
SUPABASE_JWT_SECRET=                                             # ALTERNATIVE HS256 signer. PRIVATE_KEY takes precedence.

# Logging
# LOG_LEVEL=info                                                 # OPTIONAL fatal, error, warn, info, debug, trace. Default: info, silent in tests.
