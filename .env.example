# Copy to .env.local and fill in. The defaults below match docker-compose.yml.

DATABASE_URL=postgres://catetin:catetin@localhost:54330/catetin
# Optional FX sources. Unset/blank keeps these defaults; fallback can also be "none".
# FX_PROVIDER=exchangerate-api
# FX_FALLBACK_PROVIDER=frankfurter
APP_URL=http://localhost:3000
# Other addresses allowed to open the same server (login & invite links follow that address).
# Comma-separated, * = wildcard. If empty: in dev, localhost on any port + ngrok +
# cloudflared automatically; in production (`next start`/Vercel) only APP_URL. To test `next start` via ngrok:
# APP_ALLOWED_HOSTS=localhost:*,*.ngrok-free.app
APP_ALLOWED_HOSTS=
BETTER_AUTH_SECRET=ganti-dengan-string-acak-minimal-32-karakter

# Google login (optional in dev; email-code login still works)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Dev: Mailpit (http://localhost:8026). Production: configure your SMTP provider.
SMTP_HOST=localhost
SMTP_PORT=1026
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Catetin
SMTP_FROM_EMAIL=no-reply@catetin.local

CRON_SECRET=ganti-dengan-string-acak
SIGNING_SECRET=ganti-dengan-string-acak

# Web push (generate: bunx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# AI assistant — API key from Google AI Studio
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite
# Fallback when the main model hits Google's limit (429). "none" = no fallback.
# GEMINI_FALLBACK_MODEL=gemini-3.5-flash
# Assistant daily quota. Leave empty on the real server (defaults 15 / 60 / 450).
# For testing on a laptop it can be large, e.g. 100000.
# ASSISTANT_USER_MESSAGES_PER_DAY=15
# ASSISTANT_USER_CALLS_PER_DAY=60
# ASSISTANT_APP_CALLS_PER_DAY=450

# local = .data/files folder ; supabase = Supabase Storage (requires URL + server key)
STORAGE_DRIVER=local
SUPABASE_URL=
# Server/browser keys: sb_secret_… / sb_publishable_…; configure JWT signing separately.
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_PRIVATE_KEY=
# Legacy (older projects, until end of 2026)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# pg = LISTEN/NOTIFY + SSE (dev) ; supabase = Supabase Realtime (production)
REALTIME_DRIVER=pg
