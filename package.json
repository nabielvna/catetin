{
  "name": "catetin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "test": "vitest run --project unit",
    "test:db": "bun tests/prepare-database.ts",
    "test:int": "vitest run --project integration",
    "test:all": "vitest run",
    "test:e2e": "playwright test",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "format:check": "prettier --check .",
    "db:studio": "bun --env-file=.env.local run drizzle-kit studio",
    "lighthouse": "bun scripts/lighthouse.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.111",
    "@ai-sdk/react": "4.0.166",
    "@date-fns/tz": "1.5.0",
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.2.0",
    "@react-pdf/renderer": "4.9.0",
    "@supabase/supabase-js": "2.118.0",
    "ai": "7.0.162",
    "better-auth": "1.7.15",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "input-otp": "1.5.0",
    "jsqr": "1.4.0",
    "lucide-react": "1.66.0",
    "next": "16.4.4",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "nodemailer": "10.3.1",
    "pino": "10.4.0",
    "postgres": "4.0.0",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "shadcn": "4.23.0",
    "sharp": "0.35.5",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "uuid": "14.0.3",
    "vaul": "1.1.2",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.4",
    "@testcontainers/postgresql": "12.2.1",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@types/nodemailer": "8.0.2",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/web-push": "3.6.4",
    "@typescript/native": "npm:typescript@7.0.2",
    "chrome-launcher": "1.2.2",
    "drizzle-kit": "0.31.11",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "fast-check": "4.10.2",
    "lefthook": "2.2.2",
    "lighthouse": "13.6.0",
    "pino-pretty": "13.2.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "puppeteer-core": "25.16.0",
    "tailwindcss": "4.3.4",
    "testcontainers": "12.2.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.1.0"
  },
  "packageManager": "bun@1.4.4",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "esbuild",
    "lefthook",
    "sharp",
    "unrs-resolver"
  ],
  "engines": {
    "bun": "1.4.4"
  },
  "overrides": {
    "@typescript/old": "npm:typescript@6.0.3",
    "fast-uri": "3.1.9",
    "glob": "14.0.3",
    "ip-address": "10.7.6",
    "minimatch@>=7 <11": "11.0.4",
    "source-map-js": "1.2.2",
    "systeminformation": "5.33.19",
    "undici@^7": "7.30.1",
    "undici@^8": "8.12.3",
    "vite": "8.3.5",
    "zod": "4.6.7",
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "prettier": {
    "printWidth": 120,
    "tabWidth": 2,
    "useTabs": false,
    "endOfLine": "lf",
    "semi": true,
    "singleQuote": false,
    "jsxSingleQuote": false,
    "quoteProps": "consistent",
    "trailingComma": "all",
    "arrowParens": "always",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "objectWrap": "collapse",
    "singleAttributePerLine": false,
    "htmlWhitespaceSensitivity": "css",
    "embeddedLanguageFormatting": "auto",
    "proseWrap": "preserve",
    "plugins": [
      "prettier-plugin-tailwindcss"
    ],
    "tailwindStylesheet": "./src/app/globals.css",
    "tailwindFunctions": [
      "cn",
      "clsx",
      "cva"
    ]
  },
  "patchedDependencies": {
    "deepmerge@4.3.1": "patches/deepmerge@4.3.1.patch"
  }
}
